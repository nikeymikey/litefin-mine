{
    "id": "tv.mikeytv.app",
    "version": "2.0.200",
    "vendor": "MikeyTV",
    "type": "web",
    "main": "index.html",
    "title": "MikeyTV",
    "transparent": false,
    "appDescription": "Native Jellyfin client for WebOS",
    "disableBackHistoryAPI": true,
    "icon": "assets/icon-80.png",
    "largeIcon": "assets/icon-130.png",
    "supportGIP": true,
    "bgImage": "assets/splash.png",
    "splashBackground": "assets/splash.png",
    "bgColor": "#120a2e",
    "iconColor": "#120a2e",
    "supportTouchMode": "full",
    "enablePigScreenSaver": false,
    "screenSaverProperties": {
        "preferredType": 2
    },
    "requiredPermissions": [
        "time.query"
    ]
}